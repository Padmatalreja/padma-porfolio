# ─────────────────────────────────────────────────────────────────
# ENVIRONMENT VARIABLES — copy this file to .env.local and fill in
# ─────────────────────────────────────────────────────────────────

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Neon PostgreSQL ───────────────────────────────────────────────
# Copy your connection string from the Neon dashboard.
# Use the pooled connection string for production.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&channel_binding=require

# ── Contact form ──────────────────────────────────────────────────
# A random string used to salt IP hashes for rate-limiting.
# Generate one: openssl rand -hex 32
CONTACT_RATE_LIMIT_SALT=replace-with-a-long-random-string

# ── Admin credentials ─────────────────────────────────────────────
# Used to log in to /admin. Change these to something strong.
LOCAL_ADMIN_EMAIL=admin@portfolio.local
LOCAL_ADMIN_PASSWORD=Admin@1234

# ── Cloudinary (file uploads) ─────────────────────────────────────────────────
# Create a free account at https://cloudinary.com
# Copy from Dashboard → Settings → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
