# ─────────────────────────────────────────────────────────────────
# ENVIRONMENT VARIABLES — copy this file to .env.local and fill in
# ─────────────────────────────────────────────────────────────────

# Public site URL (no trailing slash).
# In production set this to your Vercel deployment URL, e.g.:
#   https://padma-porfolio.vercel.app
# or your custom domain:
#   https://www.yourname.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Neon PostgreSQL ───────────────────────────────────────────────
# Paste the *pooled* connection string from your Neon dashboard.
# (Project → Connection Details → Pooled connection)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&channel_binding=require

# ── Contact form rate-limiting ────────────────────────────────────
# A random string used to salt IP hashes for rate-limiting.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Or use: https://generate-random.org/string-generator
CONTACT_RATE_LIMIT_SALT=replace-with-a-long-random-string

# ── Admin credentials ─────────────────────────────────────────────
# Used to log in to /admin.
# LOCAL_ADMIN_PASSWORD also signs session tokens — changing it invalidates all active sessions.
# You may store a bcrypt hash here instead of a plain-text password.
LOCAL_ADMIN_EMAIL=admin@portfolio.local
LOCAL_ADMIN_PASSWORD=Admin@1234
