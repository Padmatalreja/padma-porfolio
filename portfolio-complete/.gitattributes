# Normalize line endings for all text files to LF in the repo,
# so the repo is consistent across Windows, macOS, and Linux.
# Git will still check out with CRLF on Windows (core.autocrlf=true default).

* text=auto eol=lf

# Explicitly LF for these types
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.css  text eol=lf
*.json text eol=lf
*.sql  text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.txt  text eol=lf
*.env* text eol=lf

# Binary files — no line-ending conversion
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.avif binary
*.otf  binary
*.ttf  binary
*.woff binary
*.woff2 binary
*.pdf  binary
*.ico  binary
